  DOMAIN-SUFFIX,189.cn
  DOMAIN-SUFFIX,ctyunxs.cn
  DOMAIN-KEYWORD,189cloud

  # >>>>> 腾讯微云 (Weiyun) <<<<<
  DOMAIN-SUFFIX,weiyun.com
  DOMAIN-KEYWORD,weiyun

  # >>>>> 移动云盘 / 和彩云 (China Mobile) <<<<<
  DOMAIN-SUFFIX,mcloud.139.com
  DOMAIN-KEYWORD,mcloud
